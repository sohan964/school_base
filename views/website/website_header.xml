<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <template
        id="school_website_header"
        inherit_id="website.layout"
        name="School Website Header"
    >

        <xpath expr="//header" position="replace">

            <header id="school_website_header">

                <!-- ================================================= -->
                <!-- TOP INFORMATION BAR -->
                <!-- ================================================= -->

                <div class="bg-dark text-white">

                    <div class="container">

                        <div
                            class="d-flex justify-content-between align-items-center py-2 small"
                        >

                            <!-- Contact Information -->

                            <div class="d-flex flex-wrap gap-4">

                                <span>
                                    <i class="fa fa-phone me-1"/>
                                    +880 1XXX-XXXXXX
                                </span>

                                <span>
                                    <i class="fa fa-envelope me-1"/>
                                    info@greenfield.edu.bd
                                </span>

                                <span class="d-none d-md-inline">
                                    <i class="fa fa-map-marker me-1"/>
                                    Dhaka, Bangladesh
                                </span>

                            </div>


                            <!-- Right Information -->

                            <div class="d-none d-md-flex gap-3">

                                <span>
                                    Academic Year 2026
                                </span>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- ================================================= -->
                <!-- MAIN NAVBAR -->
                <!-- ================================================= -->

                <nav class="navbar navbar-expand-lg bg-white shadow-sm">

                    <div class="container">

                        <!-- SCHOOL BRAND -->

                        <a
                            href="/"
                            class="navbar-brand d-flex align-items-center"
                        >

                            <!-- Company Logo -->

                            <img
                                t-att-src="'/web/image/res.company/%s/logo' % website.company_id.id"
                                alt="School Logo"
                                class="img-fluid me-3"
                                style="max-height: 55px; max-width: 100px;"
                            />


                            <!-- School Name -->

                            <div class="d-none d-sm-block">

                                <div class="fw-bold fs-5">
                                    Greenfield Academy
                                </div>

                                <div class="small text-muted">
                                    Learn • Grow • Lead
                                </div>

                            </div>

                        </a>


                        <!-- MOBILE TOGGLE -->

                        <button
                            class="navbar-toggler"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#schoolMainNavbar"
                            aria-controls="schoolMainNavbar"
                            aria-expanded="false"
                            aria-label="Toggle navigation"
                        >

                            <span class="navbar-toggler-icon"/>

                        </button>


                        <!-- NAVIGATION -->

                        <div
                            class="collapse navbar-collapse"
                            id="schoolMainNavbar"
                        >

                            <ul
                                class="navbar-nav ms-auto align-items-lg-center"
                            >

                                <!-- HOME -->

                                <li class="nav-item">

                                    <a
                                        href="/"
                                        class="nav-link active"
                                    >
                                        Home
                                    </a>

                                </li>


                                <!-- ABOUT -->

                                <li class="nav-item">

                                    <a
                                        href="/about"
                                        class="nav-link"
                                    >
                                        About
                                    </a>

                                </li>


                                <!-- ACADEMICS -->

                                <li class="nav-item">

                                    <a
                                        href="/academics"
                                        class="nav-link"
                                    >
                                        Academics
                                    </a>

                                </li>


                                <!-- ADMISSIONS -->

                                <li class="nav-item">

                                    <a
                                        href="/admissions"
                                        class="nav-link"
                                    >
                                        Admissions
                                    </a>

                                </li>


                                <!-- CAMPUS LIFE -->

                                <li class="nav-item">

                                    <a
                                        href="/campus"
                                        class="nav-link"
                                    >
                                        Campus Life
                                    </a>

                                </li>


                                <!-- NEWS -->

                                <li class="nav-item">

                                    <a
                                        href="/news"
                                        class="nav-link"
                                    >
                                        News &amp; Events
                                    </a>

                                </li>


                                <!-- CONTACT -->

                                <li class="nav-item">

                                    <a
                                        href="/contact"
                                        class="nav-link"
                                    >
                                        Contact
                                    </a>

                                </li>


                                <!-- LOGIN -->

                                <t
                                    t-call="portal.placeholder_user_sign_in"
                                />

                                <!-- LOGGED IN USER -->

                                <t
                                    t-call="portal.user_dropdown"
                                    _user_name="True"
                                    _item_class.f="dropdown"
                                    _link_class.f="nav-link"
                                    _dropdown_menu_class.f="dropdown-menu-end"
                                />

                            </ul>

                        </div>

                    </div>

                </nav>

            </header>

        </xpath>

    </template>

</odoo>