<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <!-- =========================================================
         SCHOOL EVENT LIST
    ========================================================== -->

    <record id="school_event_view_list" model="ir.ui.view">
        <field name="name">school.event.list</field>
        <field name="model">school.event</field>

        <field name="arch" type="xml">

            <list>

                <field name="name"/>

                <field name="event_type"/>

                <field name="event_date"/>

                <field name="published"/>

                <field name="active"/>

            </list>

        </field>

    </record>


    <!-- =========================================================
         SCHOOL EVENT FORM
    ========================================================== -->

    <record id="school_event_view_form" model="ir.ui.view">
        <field name="name">school.event.form</field>
        <field name="model">school.event</field>
        <field name="arch" type="xml">

            <form>

                <sheet>

                    <div class="oe_title">

                        <label for="name"/>

                        <h1>
                            <field name="name"/>
                        </h1>

                    </div>


                    <group>

                        <group>

                            <field name="event_type"/>

                            <field name="event_date"/>

                        </group>


                        <group>

                            <field name="published"/>

                            <field name="active"/>

                        </group>

                    </group>


                    <group>

                        <field name="image"/>

                    </group>


                    <notebook>

                        <page string="Description">

                            <field name="description"/>

                        </page>

                    </notebook>

                </sheet>

            </form>

        </field>

    </record>


    <!-- =========================================================
         ACTION
    ========================================================== -->

    <record id="school_event_action" model="ir.actions.act_window">
        <field name="name">News &amp; Events</field>
        <field name="res_model">school.event</field>
        <field name="view_mode">list,form</field>
    </record>


    <!-- =========================================================
         MENU
    ========================================================== -->


</odoo>